# =====================================================================================================================
#  Nyay.ai environment. ONE file for the whole repo: both the FastAPI backend and the Next.js frontend read it.
#
#  1. Copy this file to `.env` in the repository root (same folder as this file).
#  2. Fill in the values marked REQUIRED. Everything else has a working default.
#  3. Never commit `.env`. It is in .gitignore and excluded from the zip bundle (scripts/bundle.py).
#
#  With no provider keys set, every external service (OTP, payments, LLM, embeddings) runs on an offline fake, so
#  you only need a Postgres and a Redis to start. Hosted options: Supabase (Postgres) and Upstash (Redis).
#  Local option (no internet): `docker compose -f infra/docker-compose.yml up -d` and the "local" URLs below.
# =====================================================================================================================

# ---------------------------------------------------------------------------------------------------------- runtime
# dev | test | staging | prod. Fakes (OTP 000000, fake payments) only work in dev/test.
ENV=dev
LOG_LEVEL=INFO
# Where the web app is served (CORS). Comma-separated list allowed, e.g. add http://localhost:3100 for `pnpm e2e:api`.
WEB_ORIGIN=http://localhost:3000
# Where the API is reachable from the browser.
API_PUBLIC_URL=http://localhost:8100

# ---------------------------------------------------------------------------------------------- database (REQUIRED)
# Supabase → Project Settings → Database → Connection string.
#   DATABASE_URL         = "Transaction pooler" URI (port 6543). Prepared statements are disabled automatically.
#   DATABASE_DIRECT_URL  = "Direct connection" or "Session pooler" URI (port 5432). Used only for migrations.
# Plain postgres:// URLs are fine; the API switches to the asyncpg driver itself.
# Supabase example:
#   DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   DATABASE_DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Local docker stand-in:
DATABASE_URL=postgresql://nyay:nyay@localhost:55432/nyay
DATABASE_DIRECT_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# Only used by the test suite. The database name MUST contain "test"; the suite drops and recreates its schema.
TEST_DATABASE_URL=postgresql://nyay:nyay@localhost:55432/nyay_test

# ------------------------------------------------------------------------------------------------- redis (REQUIRED)
# Upstash → your database → "Connect" → redis-py / TCP. Use the rediss:// (TLS) URL.
#   REDIS_URL=rediss://default:<password>@<name>.upstash.io:6379
# Local docker stand-in:
REDIS_URL=redis://localhost:56379/0
# Only used by the test suite, which FLUSHES it: never point this at your Upstash database.
TEST_REDIS_URL=redis://localhost:56379/1

# -------------------------------------------------------------------------------------------------- auth (REQUIRED)
# Long random strings. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
VISITOR_COOKIE_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Browsers accept Secure cookies on http://localhost, so keep this true everywhere.
COOKIE_SECURE=true
COOKIE_DOMAIN=
# SMS OTP. Only "fake" exists today (accepts 000000 when ENV=dev). TODO(human): choose an SMS provider.
OTP_PROVIDER=fake

# ------------------------------------------------------------------------------------------------------- payments
# fake | razorpay. Razorpay → Dashboard → Account & Settings → API Keys / Webhooks.
PAYMENT_PROVIDER=fake
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------------------------------- AI (LLM)
# fake | gemini | groq. If the primary times out (LLM_TIMEOUT_SECONDS) or fails, the fallback is tried,
# then the built-in keyword classifier. Matching never blocks on an LLM.
LLM_PROVIDER=fake
LLM_FALLBACK_PROVIDER=none
LLM_TIMEOUT_SECONDS=3
# Google AI Studio → Get API key. Owner's choice of models (A59). Google retires model names over time: if calls
# start failing with 404, switch to a current one (e.g. GEMINI_MODEL=gemini-2.5-flash,
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001, which also supports 768 dimensions) and re-run `pnpm seed`.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
# Groq console → API Keys.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ------------------------------------------------------------------------------------------------ embeddings/vector
# fake (deterministic, offline) | gemini (uses GEMINI_API_KEY + GEMINI_EMBEDDING_MODEL).
EMBEDDINGS_PROVIDER=fake
# Fixed by the database schema (vector(768)). Changing it needs a new table and a re-index.
EMBEDDING_DIM=768
# pgvector (inside your Postgres/Supabase; enable the "vector" extension) | memory (tests only).
VECTOR_STORE=pgvector

# --------------------------------------------------------------------------- money (integer paise). TODO(human)
PLATFORM_FEE_PAISE_PER_MIN=500
GST_RATE_BPS=1800
RESERVE_CAP_PAISE=200000
MIN_TOPUP_PAISE=10000
# Minutes the wallet must cover before a consultation can start (the hold), and the range advocates may set.
RESERVE_MINUTES=5
ADVOCATE_MIN_RATE_PAISE=500
ADVOCATE_MAX_RATE_PAISE=100000

# ------------------------------------------------------------------------------- billing (Upstash free tier)
# The billing engine wakes once per BILLING_POLL_SECONDS and bills every minute that starts before its next wake-up
# (+ BILLING_LEAD_SECONDS of slack), so minutes stay prepaid with ONE Redis request per live session per minute.
# An idle system makes no Redis requests at all. Early endings are prorated to the second (A60).
BILLING_POLL_SECONDS=60
BILLING_LEAD_SECONDS=15
# A party silent (no socket, no ping) for this long ends the session; billing stops at that moment.
HEARTBEAT_TIMEOUT_SECONDS=30
# A reserved consultation nobody started is cancelled (and the hold released) after this long.
RESERVATION_TTL_MINUTES=10
# local = one API instance, chat delivered in-process (no Redis cost) | redis = several instances (Pub/Sub).
WS_FANOUT=local
# api = the billing engine runs inside the API (default) | worker = inside `pnpm worker` (needs WS_FANOUT=redis).
BILLING_RUNNER=api

# ---------------------------------------------------------------------------------------- documents (Saransh)
# postgres = bytes stored in the database (no bucket needed, fine for dev) | s3 = any S3-compatible bucket.
# Supabase Storage: Project Settings → Storage → S3 connection: endpoint https://<ref>.supabase.co/storage/v1/s3,
# region = your project region, and an S3 access key pair. Create a PRIVATE bucket.
STORAGE_PROVIDER=postgres
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# fake (offline demo text for photos) | gemini (vision OCR with GEMINI_API_KEY + GEMINI_MODEL).
# PDFs with a text layer never need OCR.
OCR_PROVIDER=fake
SARANSH_DAILY_CAP=5
SARANSH_MAX_BYTES=10485760
SARANSH_MAX_PAGES=8
OCR_MIN_CONFIDENCE=60
# Phase 2: clause-level risk analysis for the document analyser (GET /v1/saransh/documents/{id}/clauses). Keep false
# until an advocate has reviewed the rules in services/api/app/modules/saransh/clauses.py.
SARANSH_CLAUSES_ENABLED=false

# -------------------------------------------------------------------------------------------------------- product
RETENTION_DAYS=30
NEWS_CACHE_TTL_SECONDS=300
NEWS_REFRESH_MINUTES=15
RATE_LIMIT_OTP=5/600
RATE_LIMIT_MATCH=30/60
RATE_LIMIT_TOPUP=10/60
RATE_LIMIT_UPLOAD=10/3600
# These two are in-memory per API instance (no Redis requests).
RATE_LIMIT_WS=30/60
RATE_LIMIT_DEFAULT=120/60
# Audio/video calls (LiveKit). Off: the room shows "Audio calls are coming soon". TODO(human): choose a provider.
ENABLE_CALLS=false
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Real case-outcome sources stay off until there is a licensed, ToS-compliant data agreement. TODO(human).
PRAMAN_LIVE_SOURCES=false

# ---------------------------------------------------------------------------------------------- observability
# GET /metrics (Prometheus). Set METRICS_TOKEN whenever the API is reachable from the internet.
METRICS_ENABLED=true
METRICS_TOKEN=

# ------------------------------------------------------------------------------------------- web (Next.js, public)
# NEXT_PUBLIC_* values are baked in at build time: rebuild the web app after changing them.
# true = the web app runs entirely on in-browser mocks and needs no API at all.
NEXT_PUBLIC_USE_MOCKS=false
NEXT_PUBLIC_API_URL=http://localhost:8100
NEXT_PUBLIC_WS_URL=ws://localhost:8100

# Custom domain: set all of these together, then rebuild the web app.
#   NEXT_PUBLIC_SITE_URL=https://www.example.com   (canonical URLs, sitemap, Open Graph)
#   NEXT_PUBLIC_API_URL=https://api.example.com    NEXT_PUBLIC_WS_URL=wss://api.example.com
#   WEB_ORIGIN=https://www.example.com             API_PUBLIC_URL=https://api.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Offline demo only (NEXT_PUBLIC_USE_MOCKS=true): ms per simulated billed minute. The real room uses real minutes.
NEXT_PUBLIC_MOCK_MINUTE_MS=15000
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ------------------------------------------------------------------------------- optional local docker stand-ins
LOCAL_PG_PORT=55432
LOCAL_REDIS_PORT=56379
