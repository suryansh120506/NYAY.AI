{
  "name": "@nyay/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0 && node scripts/check-design.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --grep-invert @api",
    "gen:api": "openapi-typescript lib/api/generated/openapi.json -o lib/api/generated/schema.d.ts",
    "test:e2e:api": "playwright test --grep @api --project=desktop",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:visual:update": "playwright test --config playwright.visual.config.ts --update-snapshots",
    "tokens:export": "node scripts/export-tokens.mjs"
  },
  "dependencies": {
    "@next/env": "15.5.27",
    "@tanstack/react-query": "5.106.0",
    "cmdk": "^1.1.1",
    "framer-motion": "14.9.1",
    "lucide-react": "^1.68.0",
    "next": "15.5.27",
    "next-intl": "4.14.9",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-virtuoso": "4.18.20",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "3.3.7",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/noto-sans-devanagari": "5.3.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.27",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "postcss": "^8.5.32",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "vite": "^8.3.5",
    "vitest": "5.1.0"
  }
}
